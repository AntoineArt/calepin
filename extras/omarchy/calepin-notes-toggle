#!/bin/bash
# Show or hide Calepin on the "notes" special workspace (bind it to SUPER+N).

set -euo pipefail

WS="notes"
CLASS="io.github.antoineart.Calepin"
# Detached Calepin windows share the class; the notes window's title starts
# with "Calepin".
TITLE="^Calepin"

CURRENT=$(hyprctl clients -j | jq -r --arg c "$CLASS" --arg t "$TITLE" \
  'first(.[] | select(.class == $c and (.title | test($t)))) | .workspace.name' 2>/dev/null || true)

if [[ $CURRENT == "special:$WS" ]]; then
  hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$WS\")"
elif [[ -n $CURRENT ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"title:$TITLE.*\$\" })"
else
  # Calepin stays resident (see autostart.lua): this only shows its window,
  # which the window rule floats on the special workspace.
  hyprctl dispatch "hl.dsp.exec_cmd(\"calepin\")"
fi
